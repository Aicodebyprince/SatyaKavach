{
    "$schema": "https://opencode.ai/config.json",
    "model": "bai/deepseek-v4-flash",
    "provider": {
        "bai": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "B.ai",
            "options": {
                "baseURL": "https://api.b.ai/v1"
            },
            "models": {
                "hy3": {
                    "name": "Hy3",
                    "limit": {
                        "context": 1000000,
                        "output": 32768
                    }
                },
                "deepseek-v4-flash": {
                    "name": "DeepSeek V4 Flash",
                    "limit": {
                        "context": 256000,
                        "output": 16384
                    }
                },
                "deepseek-v4-flash-vision-exp": {
                    "name": "DeepSeek V4 Flash Vision Exp",
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 256000,
                        "output": 16384
                    }
                },
                "mimo-v2.5": {
                    "name": "MiMo V2.5",
                    "limit": {
                        "context": 256000,
                        "output": 16384
                    }
                }
            }
        },
        "gmi": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "GMI",
            "options": {
                "baseURL": "https://api.gmi-serving.com/v1"
            },
            "models": {
                "MiniMaxAI/MiniMax-M3": {
                    "name": "MiniMax M3",
                    "limit": {
                        "context": 1000000,
                        "output": 32768
                    }
                }
            }
        }
    }
}