[TEMPLATE]
# SatyaKavach Environment Configuration
# Copy to .env and fill in your values

# Application
# DEMO_MODE=true keeps the app fully working with zero keys (mock scores + real evidence reports)
# DEMO_MODE=false uses real ONNX model inference (needs model weights present)
DEMO_MODE=true
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/satya

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=satyakavach-media
S3_REGION=auto

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# Gemini API (get free key from https://ai.google.dev)
GEMINI_API_KEY=

# CORS (comma-separated origins — use * to allow any, or set your Vercel URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Threat Intelligence
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_APP_KEY=

# Redis (optional on Render - only needed for the Celery worker)
REDIS_URL=redis://redis:6379/0
